# Insidious environment. Copy to .env and fill in. Never commit .env.
# Every service reads only the variables it needs.

# ---------- Flagsmith ----------
# Server-side environment key (Environment Settings > Keys). Used by the store SDK with local evaluation.
FLAGSMITH_SERVER_KEY=ser.xxxxxxxxxxxxxxxxxxxx
# Client-side environment key (the environment's API key). Used by Admin API calls that need the environment.
FLAGSMITH_ENVIRONMENT_KEY=xxxxxxxxxxxxxxxxxxxx
# Organisation API key (Organisation Settings > API Keys). Used for Admin API writes (CLI init, NudgeBee HTTP tasks).
FLAGSMITH_ORG_API_KEY=xxxxxxxxxxxxxxxxxxxx
FLAGSMITH_PROJECT_ID=12345
# SDK flag API and Admin API base URLs (defaults are Flagsmith SaaS)
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
FLAGSMITH_ADMIN_URL=https://api.flagsmith.com/api/v1
# Seconds between local-evaluation refreshes of the environment document
FLAGSMITH_REFRESH_SECONDS=5
# Secret configured on the Flagsmith environment webhook (HMAC-SHA256, header X-Flagsmith-Signature)
FLAGSMITH_WEBHOOK_SECRET=change-me

# ---------- Sarvam AI ----------
SARVAM_API_KEY=xxxxxxxxxxxxxxxxxxxx
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_LLM_MODEL=sarvam-105b
# 1 = never call Sarvam, return canned responses (local dev / load tests)
SARVAM_MOCK=0

# ---------- NudgeBee ----------
NUDGEBEE_URL=https://app.nudgebee.com
NUDGEBEE_API_TOKEN=sk-nb-xxxxxxxxxxxxxxxx
NUDGEBEE_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Full Event Webhook URL including ?token=... (Admin > Integrations > Webhooks > Event Webhook)
NUDGEBEE_EVENT_WEBHOOK_URL=https://app.nudgebee.com/api/webhooks/event?token=xxxx
# Workflow IDs (copy from each workflow's URL in the Workflow Builder)
NUDGEBEE_WF_PRESALE_ID=
NUDGEBEE_WF_INCIDENT_ID=
NUDGEBEE_WF_POSTSALE_ID=
# 1 = log NudgeBee calls instead of sending them (local dev without an account)
NUDGEBEE_DRY_RUN=0

# ---------- WhatsApp (Meta Cloud API test number) ----------
WHATSAPP_TOKEN=EAAxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=insidious-verify
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxx
WHATSAPP_API_VERSION=v27.0
# 1 = log outgoing WhatsApp messages instead of sending them
WHATSAPP_DRY_RUN=0

# ---------- The founder ----------
FOUNDER_NAME=Ravi
FOUNDER_PHONE=919800000000
FOUNDER_LANGUAGE=hi-IN

# ---------- ngrok (runs on the EC2 box, forwards the static domain to the k3s ingress on :80) ----------
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxx
NGROK_DOMAIN=your-name.ngrok-free.app

# ---------- Service wiring ----------
# Public base URL of the ngrok static domain that routes to ops-bot (for Meta webhooks and NudgeBee HTTP tasks)
PUBLIC_BASE_URL=https://your-name.ngrok-free.app
PROMETHEUS_URL=http://prometheus:9090
STORE_URL=http://store-api:8000
PAYMENTS_URL=http://payments-mock:8001
GUARDIAN_URL=http://guardian:8002
OPS_BOT_URL=http://ops-bot:8003
# Shared secret NudgeBee HTTP tasks send to ops-bot as header X-Insidious-Token
INSIDIOUS_INTERNAL_TOKEN=change-me-too
